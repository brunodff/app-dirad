# COMAE GERENCIAL — variáveis de ambiente
# Copie para .env e preencha os valores reais.

# ── Supabase (novo projeto isolado em supabase.com) ──────────────────────────
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Token de segurança do endpoint /api/sync ──────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cole o mesmo valor em COMAE_GERENCIAL_TOKEN no Apps Script.
SYNC_SECRET_TOKEN=gere_um_token_aleatorio_aqui

# ── Sessão ────────────────────────────────────────────────────────────────────
SESSION_SECRET=gere_outro_token_aleatorio_aqui
